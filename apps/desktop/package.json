{
  "name": "@onlydiffs/desktop",
  "private": true,
  "version": "0.1.6",
  "description": "See what your agent changed. Talk it through.",
  "author": "hosenur",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test:renderer": "bun test src",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "bun run test:renderer && bun run test:native",
    "build": "bun run typecheck && bun run test && bun run build:vite",
    "dist": "tauri build",
    "dist:mac": "tauri build --bundles app,dmg",
    "dist:win": "tauri build --bundles nsis",
    "dist:linux": "tauri build --bundles appimage,deb",
    "tauri": "tauri",
    "channel:setup": "claude mcp remove --scope user onlydiffs >/dev/null 2>&1 || true; claude mcp add --scope user onlydiffs -- bun \"$PWD/scripts/claude-channel.ts\"",
    "sync:icons": "bun scripts/sync-file-icons.mjs",
    "social": "bun scripts/social-preview.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "@lisse/react": "^0.7.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@onlydiffs/ui": "workspace:*",
    "@pierre/diffs": "^1.3.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-virtual": "^3.14.10",
    "@tanstack/router-plugin": "^1.168.35",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "geist": "^1.7.2",
    "material-icon-theme": "^5.38.1",
    "react": "19.2.4",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
