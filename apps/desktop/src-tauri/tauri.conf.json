{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "onlydiffs",
  "version": "0.1.9",
  "identifier": "dev.hosenur.onlydiffs",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "agents/*": "agents/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1MUE1MDdFRDE5NTU4NTUKUldSVldKWFJmbEFhWmJwT0F0cGZPci9UdlFBM3ArZGFGWnlQcE5RT2pCS2FZS0dFSnNsMlpHa1oK",
      "endpoints": [
        "https://github.com/hosenur/onlydiffs/releases/latest/download/latest.json"
      ]
    }
  }
}
