{
  "name": "onlydiffs",
  "private": true,
  "description": "See what your agent changed. Talk it through.",
  "author": "hosenur",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@onlydiffs/desktop",
    "dev:web": "turbo run dev --filter=@onlydiffs/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "dist": "turbo run dist --filter=@onlydiffs/desktop"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "oxlint": "1.80.0",
    "turbo": "^2.10.12"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-aria-components": "1.20.0"
  }
}
