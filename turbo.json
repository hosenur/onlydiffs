{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "ONLYDIFFS_REPO_PATH",
    "ONLYDIFFS_STATE_DIR",
    "GROQ_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dist": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "src-tauri/target/release/bundle/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
